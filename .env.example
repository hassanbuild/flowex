# Base64-encoded 32-byte random key used to encrypt OAuth credentials at rest.
# Generate and store a unique production value outside source control.
FLOWEX_OAUTH_ENCRYPTION_KEY=

# Required in production for the external scheduler calling GET /api/follow-up/process.
# Generate 32 random bytes and encode as base64url; configure the same value in the scheduler.
CRON_SECRET=

# Base64url-encoded 32-byte key for stable, hashed Contacted links in durable team notifications.
# Generate and store a unique production value outside source control.
FLOWEX_CONTACT_ACTION_SECRET=
